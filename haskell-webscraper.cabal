cabal-version:       2.4
name:                haskell-webscraper
version:             0.1.0.0
license:             MIT
license-file:        LICENSE
description:         This project demonstrates how to build a web scraper using Haskell.
category:            Web Scraping
author:              You
maintainer:          admin@garagebarge.com
build-type:          Simple

executable haskell-webscraper
  main-is:           Main.hs
  hs-source-dirs:    app, src
  default-language:  Haskell2010
  ghc-options:       -Wall -O2
  build-depends:
      base            >=4.14 && <5,
      text            >=1.2,
      bytestring      >=0.10,
      http-conduit    >=2.3,
      http-client     >=0.7,
      http-types      >=0.12,
      tagsoup         >=0.14
